# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=your_telegram_id

# 3X-UI Panel (Finland)
XUI_FINLAND_URL=https://YOUR_FINLAND_IP:9211/YOUR_PANEL_PATH
XUI_FINLAND_LOGIN=your_panel_login
XUI_FINLAND_PASSWORD=your_panel_password
XUI_FINLAND_PORT=9211

# Reality Configuration (Finland)
REALITY_UUID=your-uuid-here
REALITY_PRIVATE_KEY=your_private_key_here
REALITY_PUBLIC_KEY=your_public_key_here
REALITY_SHORT_ID=your_short_id

# MTProto Proxy (Finland)
MTPROTO_PROXY_HOST=YOUR_FINLAND_IP
MTPROTO_PROXY_PORT=4443
MTPROTO_PROXY_SECRET=your_mtproto_secret_here

# Multi-server Endpoints Configuration
# Copy this structure and update with your actual values
ENDPOINTS_CONFIG=[
  {
    "name":"finland_xhttp",
    "label":"🇫🇮 Финляндия (xHTTP)",
    "host":"YOUR_MOSCOW_RELAY_IP",
    "port":443,
    "protocol":"vless",
    "transport":"tcp",
    "security":"reality",
    "sni":"max.ru",
    "flow":"xtls-rprx-vision"
  },
  {
    "name":"finland_grpc",
    "label":"🇫🇮 Финляндия (gRPC)",
    "host":"YOUR_MOSCOW_RELAY_IP",
    "port":444,
    "protocol":"vless",
    "transport":"grpc",
    "security":"reality",
    "sni":"max.ru",
    "serviceName":"grpc"
  },
  {
    "name":"finland_direct",
    "label":"🇫🇮 Финляндия (Direct)",
    "host":"YOUR_FINLAND_IP",
    "port":443,
    "protocol":"vless",
    "transport":"tcp",
    "security":"reality",
    "sni":"max.ru",
    "flow":"xtls-rprx-vision"
  },
  {
    "name":"telegram_mtproto",
    "label":"✈️ Telegram Proxy",
    "protocol":"mtproto",
    "host":"YOUR_FINLAND_IP",
    "port":4443,
    "secret":"your_mtproto_secret_here"
  }
]

# Database (use absolute path for Docker)
DATABASE_URL=sqlite+aiosqlite:////app/data/vpn_bot.db

# Moscow Relay Server (optional, for management)
RELAY_MOSCOW_IP=YOUR_MOSCOW_RELAY_IP
RELAY_MOSCOW_SSH_USER=ubuntu
RELAY_MOSCOW_SSH_KEY=path_to_ssh_key.pem

# Mini App (optional)
MINIAPP_URL=https://your-miniapp-domain.com
API_PUBLIC_DOMAIN=your-api-domain.com

# CloudFlare Tunnel (optional - if using CloudFlare Tunnel instead of Caddy)
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
